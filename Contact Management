import os
import time
def clear_screen():
    os.system("cls" if os.name == 'nt' else "clear")
contacts = {}
def contact_rules():
    print("Contact Management\n")
    print("1- Add a contact")
    print("2- View contact")
    print("3- Edit a contact")
    print("4- Exit")

while True:
    clear_screen()
    contact_rules()
    number = int(input("Please choose a number from 1-4 "))
    clear_screen()
# Add a contact
    if number == 1:
        id = input("Enter the contact ID: ")
        name = input("Please type a name: ")
        
        while True:
            phone = input("Please type a phone number: ")
            if phone.isdigit():
                contacts[id] = {"name": name, "phone number": phone}
                break
            else:
                print(f"\n{phone} isn't a numbers, please type digits!\n")
                continue
            

        print(f"Adding {name} to contacts...")
        time.sleep(2)
        print(f"\n{name} was added successfully.....\n")
        time.sleep(3)
# View a contact
    elif number == 2:
        print(contacts)
        input("\nPress Enter to continue...")
# Edit a contact
    elif number == 3:
        id = input("Please enter an ID edit: ")
        if id in contacts:
           new_name = input("Enter a new name: ")
           while True:
            new_phone = input("Enter a new number: ")
            if new_phone.isdigit():

                contacts[id] = {"name": new_name, "phone number": new_phone}
                print("Updating .....")
                time.sleep(2)
                print("\nSuccess....\n")
                time.sleep(2)
                break
            else:
                print(f"\n{phone} isn't a numbers, please type digits!\n")
                time.sleep(3)
                clear_screen()
                continue


        else:
           print("This ID was not found")
           time.sleep(3)


        
# To exit        
    elif number == 4:
        print("Logging out.....")
        time.sleep(2)
        clear_screen()
        print("\nExiting the programming....")
        break

    else:
        print("Invalid choice, Please enter number between 1-4")
        time.sleep(3)
